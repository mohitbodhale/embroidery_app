# ============================================
# Database Configuration — copy to .env
# ============================================

# Choose database driver: Mysql or Postgres
DB_DRIVER=Mysql

# ---------- MySQL / MariaDB (default) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=embroidery_app

# ---------- PostgreSQL (alternative) ----------
# Uncomment and set DB_DRIVER=Postgres to use PostgreSQL
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASS=
# PG_NAME=embroidery_app

# ---------- Test Database ----------
# MySQL / MariaDB test database
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASS=
TEST_DB_NAME=embroidery_app_test

# PostgreSQL test database (when DB_DRIVER=Postgres)
# TEST_PG_HOST=localhost
# TEST_PG_PORT=5432
# TEST_PG_USER=postgres
# TEST_PG_PASS=
# TEST_PG_NAME=embroidery_app_test

# ============================================
# Application
# ============================================
DEBUG=true
SECURITY_SALT=generate-with-bin-cake-security-salt

# Email (configure for your environment)
# EMAIL_TRANSPORT_DEFAULT_URL=smtp://user:pass@host:port

# Cache (optional)
# CACHE_DEFAULT_URL=redis://localhost:6379/0